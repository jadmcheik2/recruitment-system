# Database Connection
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/recruitment_db?schema=public"

# Backend Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=supersecret_access_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=supersecret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# File Storage Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001
