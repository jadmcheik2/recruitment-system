// Strict Prisma Schema for Internal Recruitment Management System matching Section 10 of PDF

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Enums
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Job Enums
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// Application Enums
enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  SELECTED
  REJECTED
}

// Interview Enums
enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// 1. users: id, email, password_hash, role_id, status
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  roleId       String     @map("role_id")
  status       UserStatus @default(ACTIVE)

  role               Role               @relation(fields: [roleId], references: [id])
  candidateProfile   Candidate?
  createdJobs        Job[]              @relation("CreatedJobs")
  assignedApps       Application[]      @relation("AssignedRecruiter")
  changedAppEvents   ApplicationEvent[] @relation("ChangedByEvents")
  conductedInterviews Interview[]       @relation("Interviewer")
  notifications      Notification[]
  auditLogs          AuditLog[]         @relation("ActorAuditLogs")

  @@map("users")
}

// 2. roles: id, name
model Role {
  id   String @id @default(uuid())
  name String @unique

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// 3. permissions: id, key, description
model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

// 4. role_permissions: role_id, permission_id
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 5. jobs: id, title, description, location, type, status, created_by
model Job {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  location    String
  type        String    // Full-time, Part-time, Remote, Contract
  status      JobStatus @default(DRAFT)
  createdBy   String    @map("created_by")

  creator      User          @relation("CreatedJobs", fields: [createdBy], references: [id])
  applications Application[]

  @@map("jobs")
}

// 6. candidates: id, user_id, name, phone, skills, resume_key
model Candidate {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  phone     String?
  skills    String[] @default([])
  resumeKey String?  @map("resume_key")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("candidates")
}

// 7. applications: id, job_id, candidate_id, recruiter_id, status, created_at
model Application {
  id          String            @id @default(uuid())
  jobId       String            @map("job_id")
  candidateId String            @map("candidate_id")
  recruiterId String?           @map("recruiter_id")
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now()) @map("created_at")

  job        Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate  Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter  User?              @relation("AssignedRecruiter", fields: [recruiterId], references: [id])
  events     ApplicationEvent[]
  interviews Interview[]

  @@unique([jobId, candidateId])
  @@map("applications")
}

// 8. application_events: id, application_id, from_status, to_status, changed_by
model ApplicationEvent {
  id            String             @id @default(uuid())
  applicationId String             @map("application_id")
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedBy     String             @map("changed_by")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changer     User        @relation("ChangedByEvents", fields: [changedBy], references: [id])

  @@map("application_events")
}

// 9. interviews: id, application_id, scheduled_at, interviewer_id, notes, status
model Interview {
  id            String          @id @default(uuid())
  applicationId String          @map("application_id")
  scheduledAt   DateTime        @map("scheduled_at")
  interviewerId String          @map("interviewer_id")
  notes         String?         @db.Text
  status        InterviewStatus @default(SCHEDULED)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User        @relation("Interviewer", fields: [interviewerId], references: [id])

  @@map("interviews")
}

// 10. notifications: id, user_id, type, title, message, read_at
model Notification {
  id      String    @id @default(uuid())
  userId  String    @map("user_id")
  type    String
  title   String
  message String
  readAt  DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// 11. audit_logs: id, actor_id, action, entity_type, entity_id, metadata, created_at
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@map("audit_logs")
}
